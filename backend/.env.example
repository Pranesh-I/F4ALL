# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
DEBUG=true

# Matches docker-compose.yml (port 5433 avoids shadowing a local Postgres)
DATABASE_URL=postgresql+psycopg://f4all_user:f4all_password@localhost:5433/f4all_db
# Production requires TLS to the database: append ?sslmode=require (or verify-full).
REDIS_URL=redis://localhost:6380/0

# CHANGE THIS. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Access tokens are short-lived; refresh tokens are stored, rotated and revocable.
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=90

# Development convenience: ignored in production/staging regardless of value.
ALLOW_UNAUTHENTICATED=true

# OTP delivery. "console" logs the (fixed, development-only) code; production
# requires "http" and a DLT-registered sender id and template from SAI.
SMS_BACKEND=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_PAYLOAD_TEMPLATE=to={phone}&body={message}&sender={sender_id}

# Notifications (Sprint 17). "console" logs pushes; "fcm" sends them through
# Firebase Cloud Messaging (needs the project id and a service-account key file
# that is never committed); "inbox" sends no pushes and phones read their inbox.
# Production accepts "fcm" or "inbox". Run the notifier with
# `python -m app.notifications.dispatch`.
NOTIFICATION_PROVIDER=console
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
NOTIFIER_INTERVAL_SECONDS=30
SESSION_ENDING_SOON_HOURS=24

# Where browsers reach this API (local media URLs are signed against it), and
# which dashboard origins may call it. JSON list.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]

# "local" or "s3". S3 is required in production.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
S3_BUCKET=
S3_REGION=ap-south-1

UPLOAD_CHUNK_SIZE_BYTES=262144
UPLOAD_MAX_FILE_BYTES=209715200
# JSON list. The app uploads H.264 MP4 only.
UPLOAD_ALLOWED_CONTENT_TYPES=["video/mp4"]

VERIFICATION_SLA_SECONDS=300
DISCREPANCY_TOLERANCE_REPS=2
DISCREPANCY_TOLERANCE_CM=5
# Agreeing scores are still flagged below this server tracking quality (0..1).
VERIFICATION_MIN_CONFIDENCE=0.55

# Integrity (anti-cheat) limits. Leave unset to use the defaults documented
# beside each check in app/verification/cheat/; set only to tune on pilot data.
# INTEGRITY_MULTI_PERSON_FRACTION=0.15
# INTEGRITY_MIN_SUBJECT_FRACTION=0.35
# INTEGRITY_CONFIDENT_SUBJECT_FRACTION=0.6
# INTEGRITY_DUPLICATE_FRAME_RATIO=0.15
# INTEGRITY_FAST_REP_FRACTION=0.3
# INTEGRITY_MAX_HIP_SPEED=15
# INTEGRITY_JUMP_TIME_SCALE_LIMIT=1.6
# INTEGRITY_NEAR_DUPLICATE_MAE=3.0

# --- Rate limits (Sprint 20), requests per minute ---
# "memory" counts in this process; production requires "redis" (REDIS_URL).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_SIGN_IN_PER_MINUTE=10
RATE_LIMIT_OTP_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=1200
# Only behind a proxy that sets X-Forwarded-For itself; otherwise a client can
# claim any address and get a fresh allowance.
RATE_LIMIT_TRUST_FORWARDED=false

# --- Retention (Sprint 20), in days; reasons in docs/PRIVACY.md ---
RETENTION_VIDEO_DAYS=365
RETENTION_IDENTITY_CHECK_DAYS=90
RETENTION_NOTIFICATION_DAYS=365
RETENTION_ACCESS_LOG_DAYS=730
RETENTION_OTP_DAYS=30
RETENTION_REFRESH_TOKEN_DAYS=30
RETENTION_UPLOAD_DAYS=7
