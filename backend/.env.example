# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
DEBUG=true

# Matches docker-compose.yml (port 5433 avoids shadowing a local Postgres)
DATABASE_URL=postgresql+psycopg://f4all_user:f4all_password@localhost:5433/f4all_db
REDIS_URL=redis://localhost:6379/0

# CHANGE THIS. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Development convenience: ignored in production/staging regardless of value.
ALLOW_UNAUTHENTICATED=true

# "local" or "s3". S3 is required in production.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
S3_BUCKET=
S3_REGION=ap-south-1

UPLOAD_CHUNK_SIZE_BYTES=262144
UPLOAD_MAX_FILE_BYTES=209715200

VERIFICATION_SLA_SECONDS=300
DISCREPANCY_TOLERANCE_REPS=2
DISCREPANCY_TOLERANCE_CM=5
