# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
DEBUG=true

# Matches docker-compose.yml (port 5433 avoids shadowing a local Postgres)
DATABASE_URL=postgresql+psycopg://f4all_user:f4all_password@localhost:5433/f4all_db
REDIS_URL=redis://localhost:6379/0

# CHANGE THIS. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Access tokens are short-lived; refresh tokens are stored, rotated and revocable.
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=90

# Development convenience: ignored in production/staging regardless of value.
ALLOW_UNAUTHENTICATED=true

# OTP delivery. "console" logs the (fixed, development-only) code; production
# requires "http" and a DLT-registered sender id and template from SAI.
SMS_BACKEND=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_PAYLOAD_TEMPLATE=to={phone}&body={message}&sender={sender_id}

# Where browsers reach this API (local media URLs are signed against it), and
# which dashboard origins may call it. JSON list.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]

# "local" or "s3". S3 is required in production.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
S3_BUCKET=
S3_REGION=ap-south-1

UPLOAD_CHUNK_SIZE_BYTES=262144
UPLOAD_MAX_FILE_BYTES=209715200

VERIFICATION_SLA_SECONDS=300
DISCREPANCY_TOLERANCE_REPS=2
DISCREPANCY_TOLERANCE_CM=5
