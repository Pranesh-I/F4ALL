<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for API 31+.

   The encrypted session is excluded from both: its Keystore key does not travel,
   so restored ciphertext would be unreadable. A new phone asks for a fresh login.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="f4all_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="f4all_session.xml" />
    </device-transfer>
</data-extraction-rules>
