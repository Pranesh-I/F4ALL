<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for API 30 and below.

   The encrypted session is excluded: its Keystore key never leaves the device,
   so a restored copy is undecryptable and would crash the app on first launch.
   Excluding it means a restored phone simply asks the athlete to log in again.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="f4all_session.xml" />
</full-backup-content>
