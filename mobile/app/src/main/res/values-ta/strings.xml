    <string name="photo_title">உங்கள் புகைப்படத்தைச் சேர்க்கவும்</string>
    <string name="photo_body">சோதனைக் காணொளிகளில் இருப்பது நீங்கள்தான் என்பதை உறுதிசெய்ய SAI இந்தப் புகைப்படத்தைப் பயன்படுத்துகிறது. நல்ல வெளிச்சத்தில், தொப்பி அல்லது கருப்புக் கண்ணாடி இல்லாமல் கேமராவைப் பாருங்கள்.</string>
    <string name="photo_privacy">உங்கள் புகைப்படம் தனிப்பட்ட முறையில் சேமிக்கப்படும்; உங்கள் முடிவுகளைச் சரிபார்க்கும் SAI அதிகாரிகள் மட்டுமே பார்ப்பார்கள்.</string>
    <string name="photo_take">புகைப்படம் எடு</string>
    <string name="photo_skip">இப்போது தவிர்</string>
    <string name="photo_error_none">புகைப்படம் எடுக்கப்படவில்லை. மீண்டும் முயற்சி செய்யவும் அல்லது இப்போது தவிர்க்கவும்.</string>
    <string name="photo_error_unreadable">இந்தப் புகைப்படத்தைப் படிக்க முடியவில்லை. மீண்டும் முயற்சி செய்யவும்.</string>
    <string name="photo_error_upload">புகைப்படத்தைப் பதிவேற்ற முடியவில்லை. மீண்டும் முயற்சி செய்யவும்.</string>

    <string name="instructions_setup">தொலைபேசியை அமைக்கவும்</string>
    <string name="instructions_movement">சோதனையை எப்படிச் செய்வது</string>
    <string name="instructions_start">நான் தயார் — தொடங்கு</string>
    <string name="diagram_setup">படம்: நிலையான தாங்கியில் தொலைபேசி, வீரரிடமிருந்து இரண்டு முதல் மூன்று மீட்டர் தொலைவில், வீரர் பக்கவாட்டில் நிற்கிறார்</string>
    <string name="setup_step_distance">தொலைபேசியை 2 முதல் 3 மீட்டர் தொலைவில், இடுப்பு உயரத்தில் வைக்கவும்.</string>
    <string name="setup_step_steady">தொலைபேசியை அசையாமல் வைக்கவும். எதன் மீதாவது சாய்த்து வைக்கவும் அல்லது யாரையாவது நிலையாகப் பிடிக்கச் சொல்லவும்.</string>
    <string name="setup_step_side_on">தொலைபேசிக்குப் பக்கவாட்டில் நிற்கவும் அல்லது படுக்கவும்; தலை முதல் கால் வரை முழு உடலும் தெரிய வேண்டும்.</string>
    <string name="setup_step_light">வெளிச்சமான இடத்தைப் பயன்படுத்தவும். பின்னால் ஜன்னல் அல்லது சூரியன் இருக்கக் கூடாது.</string>
    <string name="diagram_situp_down">தொடக்கம்: மல்லாந்து படுத்து, முழங்கால்களை மடக்கவும்</string>
    <string name="diagram_situp_up">மேலே: முழுமையாக எழுந்து உட்காரவும்</string>
    <string name="situp_step_lie">மல்லாந்து படுத்து, முழங்கால்களை மடக்கி, பாதங்களைத் தரையில் வைக்கவும்.</string>
    <string name="situp_step_up">மார்பு முழங்கால்களுக்கு அருகில் வரும் வரை முழுமையாக எழுந்து உட்காரவும்.</string>
    <string name="situp_step_down">அடுத்த முறைக்கு முன் முழுமையாகப் பின்னால் படுக்கவும்.</string>
    <string name="situp_step_repeat">நேரம் முடியும் வரை முடிந்தவரை அதிகம் செய்யவும்.</string>
    <string name="situp_counts">முழுமையாக எழுந்து, முழுமையாகப் பின்னால் படுத்தால் மட்டுமே சிட்-அப் கணக்கிடப்படும். பாதி சிட்-அப்கள் கணக்கிடப்படாது.</string>
    <string name="diagram_jump_stand">தொடக்கம்: அசையாமல் நில்லுங்கள்</string>
    <string name="diagram_jump_peak">நேராக மேலே தாவுங்கள்</string>
    <string name="jump_step_still">3-2-1 எண்ணிக்கையின் போது அசையாமல் நில்லுங்கள். இதனால் செயலி உங்கள் உயரத்தை அளக்கும்.</string>
    <string name="jump_step_jump">முடிந்தவரை உயரமாக நேராக மேலே தாவுங்கள்.</string>
